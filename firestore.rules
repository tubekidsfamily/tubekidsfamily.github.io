rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // App settings: anyone can read (so the app works for everyone), only admins can change
    match /app/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin list: document ID = admin email in lowercase
    match /admins/{email} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email.lower() == email);
      allow create, update, delete: if isAdmin();
    }
  }
}
