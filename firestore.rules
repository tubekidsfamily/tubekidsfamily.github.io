rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // the signed-in user's id: email (lowercase) or phone number (+20...)
    function em() { return request.auth.token.get('email', '').lower(); }
    function ph() { return request.auth.token.get('phone_number', ''); }
    function isMe(id) { return signedIn() && (id == em() || id == ph()); }

    function hasUser(i) { return i != '' && exists(/databases/$(database)/documents/users/$(i)); }
    function rec(i) { return get(/databases/$(database)/documents/users/$(i)).data; }
    // added by an admin, not suspended, not expired
    function okUser(i) {
      return hasUser(i)
        && rec(i).get('disabled', false) != true
        && (rec(i).get('expires', null) == null || rec(i).expires > request.time);
    }
    function hasRole(roles) {
      return signedIn() && ((okUser(em()) && rec(em()).get('role', 'viewer') in roles)
                         || (okUser(ph()) && rec(ph()).get('role', 'viewer') in roles));
    }
    function isAdmin() { return hasRole(['admin']); }
    function isEditor() { return hasRole(['admin', 'editor']); }
    function isOpen() {
      return exists(/databases/$(database)/documents/app/access)
          && get(/databases/$(database)/documents/app/access).data.open == true;
    }
    // can watch: an active user, or anyone signed in when access is open (unless suspended/expired)
    function canWatch() {
      return signedIn() && (okUser(em()) || okUser(ph()) || (!hasUser(em()) && !hasUser(ph()) && isOpen()));
    }

    match /app/access { allow read: if signedIn(); allow write: if isAdmin(); }
    match /app/config { allow read: if canWatch() || isEditor(); allow write: if isEditor(); }

    // users/{email or +phone}: role (viewer/editor/admin), disabled, expires, channels
    match /users/{id} { allow read: if isAdmin() || isMe(id); allow write: if isAdmin(); }

    // last seen per user (each user updates their own)
    match /activity/{id} { allow read: if isAdmin() || isMe(id); allow create, update: if isMe(id); }

    // sign-in log and watched videos (each user adds their own rows, admins read)
    match /logins/{doc} { allow read: if isAdmin(); allow create: if signedIn() && isMe(request.resource.data.id); }
    match /views/{doc}  { allow read: if isAdmin(); allow create: if signedIn() && isMe(request.resource.data.id); }
  }
}
